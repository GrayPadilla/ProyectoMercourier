flex-wrap: wrap;rn  }rnrn  .carrusel-buttons .btn {rn    background-color: #e63946;rn    color: #ffffff !important;rn    border: none;rn    padding: 14px 30px;rn    border-radius: 8px;rn    font-weight: bold;rn    text-decoration: none;rn    transition: background-color 0.3s ease;rn    font-size: 1rem;rn    display: inline-block;rn  }rnrn  .carrusel-buttons .btn:hover {rn    background-color: #ff5b5b;rn  }rnrn  /* Flechas */rn  .carrusel-arrow {rn    position: absolute;rn    top: 50%;rn    transform: translateY(-50%);rn    background-color: rgba(0, 0, 0, 0.5);rn    color: white;rn    border: none;rn    padding: 15px 20px;rn    font-size: 24px;rn    border-radius: 50%;rn    cursor: pointer;rn    z-index: 4;rn    transition: 0.3s;rn  }rnrn  .carrusel-arrow.left { left: 20px; }rn  .carrusel-arrow.right { right: 20px; }rnrn  /* ======== AJUSTES PARA TABLET Y Mu00d3VIL (RESPONSIVE) ======== */rn  rn  /* Tablets */rn  @media (max-width: 1024px) {rn    .carrusel-content {rn      padding-left: 5%;rn      max-width: 80%;rn    }rn    .carrusel-content h2 {rn      font-size: 3rem;rn    }rn  }rnrn  /* Celulares */rn  @media (max-width: 768px) {rn    .carrusel-container {rn      height: 70vh; /* Altura mu00e1s cu00f3moda para mu00f3viles */rn    }rn    rn    .carrusel-content {rn      padding: 0 40px; /* Centramos visualmente en mu00f3viles para que no se corte */rn      text-align: center;rn      padding-left: 20px; /* Ajuste para que no pegue al borde */rn    }rnrn    .carrusel-content h2 {rn      font-size: 1.8rem;rn      text-align: left; /* Mantiene la alineaciu00f3n izquierda si asu00ed lo prefieres */rn    }rnrn    .carrusel-buttons {rn      justify-content: flex-start;rn    }rnrn    .carrusel-arrow {rn      padding: 10px 15px;rn      font-size: 18px;rn    }rn  }rn</style>rnrn<div class="carrusel-container">rn  <div class="carrusel-slide active" style="background-image: url('https://mercourier.com/wp-content/uploads/2026/01/41-3.png');">rn    <div class="carrusel-overlay"></div>rn    <div class="carrusel-content">rn      <h2>Entrega ru00e1pida y segura en cada pedido</h2>rn      <div class="carrusel-buttons">rn        <a href="https://mercourier.com/contact/" class="btn">Conoce mu00e1s</a>rn        <a href="https://mercourier.com/dashboard/" class="btn">Zona de clientes</a>rn      </div>rn    </div>rn  </div>rnrn  <div class="carrusel-slide" style="background-image: url('https://mercourier.com/wp-content/uploads/2026/02/1920x1080-img-para-pagina-MERC-1.png');">rn    <div class="carrusel-overlay"></div>rn    <div class="carrusel-content">rn      <h2>Conectamos destinos, entregamos confianza</h2>rn    </div>rn  </div>rnrn  <div class="carrusel-slide" style="background-image: url('https://mercourier.com/wp-content/uploads/2026/01/11-1.png');">rn    <div class="carrusel-overlay"></div>rn    <div class="carrusel-content">rn      <h2>Tu envu00edo, nuestra prioridad</h2>rn    </div>rn  </div>rnrn  <button class="carrusel-arrow left">&#10094;</button>rn  <button class="carrusel-arrow right">&#10095;</button>rn</div>rnrn<script>rn  document.addEventListener("DOMContentLoaded", function() {rn    const slides = document.querySelectorAll(".carrusel-slide");rn    const prevBtn = document.querySelector(".carrusel-arrow.left");rn    const nextBtn = document.querySelector(".carrusel-arrow.right");rn    let currentIndex = 0;rnrn    function showSlide(index) {rn      slides.forEach((slide, i) => {rn        slide.classList.remove("active");rn        if (i === index) slide.classList.add("active");rn      });rn    }rnrn    prevBtn.addEventListener("click", () => {rn      currentIndex = (currentIndex - 1 + slides.length) % slides.length;rn      showSlide(currentIndex);rn    });rnrn    nextBtn.addEventListener("click", () => {rn      currentIndex = (currentIndex + 1) % slides.length;rn      showSlide(currentIndex);rn    });rnrn    // Cambio automu00e1tico cada 6 segundosrn    setInterval(() => {rn      currentIndex = (currentIndex + 1) % slides.length;rn      showSlide(currentIndex);rn    }, 6000);rn  });rn</script>tttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-2313f1c e-flex e-con-boxed e-con e-parent" data-id="2313f1c" data-element_type="container" data-e-type="container">nttttt<div class="e-con-inner">ntttt<div class="elementor-element elementor-element-7231bc3 elementor-widget-divider--view-line elementor-widget elementor-widget-divider" data-id="7231bc3" data-element_type="widget" data-e-type="widget" data-widget_type="divider.default">nttttttt<div class="elementor-divider">nttt<span class="elementor-divider-separator">ntttttt</span>ntt</div>ntttttt</div>ntttt<div class="elementor-element elementor-element-6632840 elementor-widget elementor-widget-heading" data-id="6632840" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">nttttt<h2 class="elementor-heading-title elementor-size-default">TRACKING MERCOURIER</h2>tttt</div>nttttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-ba4811b e-con-full e-flex e-con e-parent" data-id="ba4811b" data-element_type="container" data-e-type="container">ntt<div class="elementor-element elementor-element-20a50ec e-con-full e-flex e-con e-child" data-id="20a50ec" data-element_type="container" data-e-type="container">ntttt<div class="elementor-element elementor-element-e61c0f7 elementor-widget elementor-widget-html" data-id="e61c0f7" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">nttttt<div class="container-premium-grande">rn    <div class="glass-bg-extra"></div>rn    rn    <div class="image-frame-extra">rn        <img src="https://mercourier.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-17-at-12.20.32-PM.jpeg" alt="Courier Olva">rn    </div>rn</div>rnrn<style>rn    /* Contenedor principal mu00e1s amplio */rn    .container-premium-grande {rn        position: relative;rn        width: 100%;rn        max-width: 900px; /* Aumentado de 650px a 900px */rn        height: 550px;    /* Aumentado de 400px a 550px */rn        margin: 60px auto;rn        display: flex;rn        align-items: center;rn        justify-content: center;rn        perspective: 1200px; /* Profundidad mejorada para el tamau00f1o grande */rn    }rnrn    /* Fondo Rojo Liquid Glass */rn    .glass-bg-extra {rn        position: absolute;rn        width: 95%;rn        height: 90%;rn        background: rgba(227, 6, 19, 0.88);rn        rn        /* Efecto Liquid Glass */rn        backdrop-filter: blur(18px) saturate(180%);rn        -webkit-backdrop-filter: blur(18px) saturate(180%);rn        rn        /* Bordes curvos profesionales */rn        border-radius: 60px 180px 70px 150px; rn        rn        /* Inclinaciu00f3n lateral (de costado) */rn        transform: rotateX(4deg) rotateY(-12deg) rotateZ(-2deg);rn        rn        border: 1.5px solid rgba(255, 255, 255, 0.3);rn        box-shadow: -30px 30px 60px rgba(0,0,0,0.25);rn        z-index: 1;rn        transition: all 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);rn    }rnrn    /* Marco de la Imagen */rn    .image-frame-extra {rn        position: relative;rn        width: 88%;rn        height: 85%;rn        z-index: 2;rn        overflow: hidden;rn        rn        /* Curvas asimu00e9tricas suaves */rn        border-radius: 50px 130px 50px 110px;rn        rn        /* Inclinaciu00f3n coordinada */rn        transform: rotateX(4deg) rotateY(-8deg);rn        box-shadow: 20px 25px 50px rgba(0,0,0,0.35);rn        transition: all 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);rn    }rnrn    .image-frame-extra img {rn        width: 100%;rn        height: 100%;rn        object-fit: cover;rn        display: block;rn        transition: transform 0.8s ease;rn    }rnrn    /* Interacciu00f3n Hover */rn    .container-premium-grande:hover .glass-bg-extra {rn        transform: rotateX(0deg) rotateY(-4deg) rotateZ(0deg) scale(1.02);rn        background: rgba(227, 6, 19, 1);rn    }rnrn    .container-premium-grande:hover .image-frame-extra {rn        transform: rotateX(0deg) rotateY(0deg) scale(1.03);rn    }rnrn    .container-premium-grande:hover img {rn        transform: scale(1.1);rn    }rnrn    /* Responsive: Se adapta a pantallas pequeu00f1as */rn    @media (max-width: 900px) {rn        .container-premium-grande {rn            height: 400px;rn            max-width: 95%;rn        }rn    }rnrn    @media (max-width: 480px) {rn        .container-premium-grande {rn            height: 300px;rn            perspective: none;rn        }rn        .glass-bg-extra, .image-frame-extra {rn            border-radius: 30px 80px 30px 70px;rn            transform: rotate(-2deg);rn        }rn    }rn</style>tttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-99cfa00 e-con-full e-flex e-con e-child" data-id="99cfa00" data-element_type="container" data-e-type="container">ntt<div class="elementor-element elementor-element-596ae6e e-con-full e-flex e-con e-child" data-id="596ae6e" data-element_type="container" data-e-type="container">ntt[elementor-element k="f0ed140f8b6c5ed68b460c37d284d5b3" data="eyJpZCI6IjQ3OGMwYjkiLCJlbFR5cGUiOiJ3aWRnZXQiLCJzZXR0aW5ncyI6eyJzaG9ydGNvZGUiOiJbd3BjYXJnb190cmFja2Zvcm1dIn0sImVsZW1lbnRzIjpbXSwid2lkZ2V0VHlwZSI6InNob3J0Y29kZSJ9"]tt</div>ntttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-c2f5d6c e-con-full e-flex e-con e-parent" data-id="c2f5d6c" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">ntt<div class="elementor-element elementor-element-af6d2a1 e-con-full e-flex e-con e-child" data-id="af6d2a1" data-element_type="container" data-e-type="container">ntttt<div class="elementor-element elementor-element-7115544 elementor-widget elementor-widget-heading" data-id="7115544" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">nttttt<h2 class="elementor-heading-title elementor-size-default">Nuestros Servicios</h2>tttt</div>ntttt<div class="elementor-element elementor-element-9eaedad elementor-widget elementor-widget-html" data-id="9eaedad" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">nttttt<div class="merc-servicios-wrapper">rn  <div class="servicios-loop-container" id="carrusel-drag">rn    <div class="servicios-track" id="track">rn      </div>rn  </div>rn</div>rnrn<style>rn/* Wrapper principal */rn.merc-servicios-wrapper {rn  width: 100%;rn  margin: 0 auto;rn  background: transparent;rn  padding: 50px 0;rn}rnrn.merc-servicios-wrapper .servicios-loop-container {rn  overflow-x: auto;rn  scrollbar-width: none;rn  -ms-overflow-style: none;rn  cursor: grab;rn  user-select: none;rn}rnrn.merc-servicios-wrapper .servicios-loop-container::-webkit-scrollbar {rn  display: none;rn}rnrn.merc-servicios-wrapper .servicios-track {rn  display: flex;rn  /* Espaciado amplio entre tarjetas solicitado */rn  gap: 80px; rn  animation: merc-scroll-infinito 40s linear infinite;rn}rnrn.merc-servicios-wrapper .servicio-card {rn  /* Ancho amplio para evitar que se vea amontonado */rn  width: 420px; rn  background: #111;rn  border-radius: 15px;rn  overflow: hidden;rn  border: 1px solid #333;rn  border-bottom: 6px solid #49080A;rn  flex-shrink: 0;rn  transition: transform 0.4s ease, border-color 0.4s ease;rn}rnrn.merc-servicios-wrapper .servicio-card:hover {rn  transform: translateY(-12px);rn  border-color: #49080A;rn}rnrn.merc-servicios-wrapper .servicio-card img {rn  width: 100%;rn  height: 240px;rn  object-fit: cover;rn}rnrn.merc-servicios-wrapper .card-body { rn  padding: 35px; rn}rnrn.merc-servicios-wrapper .tag { rn  color: #ff5b5b; rn  font-size: 11px; rn  font-weight: bold; rn  letter-spacing: 3px; rn  text-transform: uppercase;rn}rnrn.merc-servicios-wrapper .card-body h3 { rn  color: #fff !important; /* Aseguramos color blanco */rn  font-family: 'Montserrat', Sans-Serif; rn  margin: 15px 0; rn  font-size: 1.6rem; rn}rnrn.merc-servicios-wrapper .card-body p { rn  color: #ccc; rn  font-size: 1rem; rn  margin-bottom: 25px; rn  line-height: 1.7; rn}rnrn.merc-servicios-wrapper .btn-card {rn  display: inline-block;rn  padding: 14px 28px;rn  background: #49080A;rn  color: #fff !important;rn  text-decoration: none;rn  font-weight: bold;rn  border-radius: 8px;rn  font-size: 0.95rem;rn  transition: background 0.3s;rn}rnrn.merc-servicios-wrapper .btn-card:hover {rn  background: #e63946;rn}rnrn/* --- ANIMACIu00d3N MATEMu00c1TICA --- */rn@keyframes merc-scroll-infinito {rn  0% { transform: translateX(0); }rn  100% { transform: translateX(calc((-420px - 80px) * 4)); }rn}rnrn.merc-servicios-wrapper .servicios-loop-container:hover .servicios-track {rn  animation-play-state: paused;rn}rnrn/* ======== RESPONSIVE ======== */rn@media (max-width: 1024px) {rn  .merc-servicios-wrapper .servicio-card {rn    width: 350px;rn  }rn  @keyframes merc-scroll-infinito {rn    0% { transform: translateX(0); }rn    100% { transform: translateX(calc((-350px - 80px) * 4)); }rn  }rn}rnrn@media (max-width: 768px) {rn  .merc-servicios-wrapper .servicio-card {rn    width: 300px;rn  }rn  .merc-servicios-wrapper .servicios-track {rn    gap: 40px;rn  }rn  @keyframes merc-scroll-infinito {rn    0% { transform: translateX(0); }rn    100% { transform: translateX(calc((-300px - 40px) * 4)); }rn  }rn}rn</style>rnrn<script>rn(function() {rn  const servicios = [rn    {rn      img: 'https://mercourier.com/wp-content/uploads/2026/01/IMAGENES-PAGINA-1024X1024.png',rn      alt: 'Merc Emprendedor',rn      titulo: 'MERC EMPRENDEDOR',rn      descripcion: '<strong>MERC EMPRENDEDOR</strong> es un servicio con tarifa plana de S/10. Ofrece recojo matutino, entrega por la tarde y seguro gratuito hasta S/300.',rn      enlace: 'https://mercourier.com/merc-emprendedor/'rn    },rn    {rn      img: 'https://mercourier.com/wp-content/uploads/2026/02/3.png',rn      alt: 'Merc Agencia',rn      titulo: 'MERC AGENCIA',rn      descripcion: '<strong>MERC AGENCIA</strong> ofrece envu00edos con tarifa plana de S/8. Recibe pedidos hasta las 12:30 pm e incluye seguro de S/300.',rn      enlace: 'https://mercourier.com/merc-agencia/'rn    },rn    {rn      img: 'https://mercourier.com/wp-content/uploads/2026/02/4.png',rn      alt: 'Merc Express',rn      titulo: 'MERC EXPRESS',rn      descripcion: '<strong>MERC EXPRESS</strong> es entrega personalizada en 1 a 2 horas. Cuesta S/2.50 por km y ofrece seguro de S/300.',rn      enlace: 'https://mercourier.com/merc-express/'rn    },rn    {rn      img: 'https://mercourier.com/wp-content/uploads/2026/01/11.png',rn      alt: 'Merc Fullfillment',rn      titulo: 'MERC FULLFILLMENT',rn      descripcion: '<strong>MERC FULFILLMENT</strong> gestiona almacenamiento e inventario. Ofrece entregas el mismo du00eda y seguro de S/300.',rn      enlace: 'https://mercourier.com/merc-fullfitment/'rn    }rn  ];rnrn  function crearCard(servicio) {rn    return `rn      <div class="servicio-card">rn        <img src="${servicio.img}" alt="${servicio.alt}">rn        <div class="card-body">rn          <span class="tag">SERVICIO ESPECIALIZADO</span>rn          <h3>${servicio.titulo}</h3>rn          <p>${servicio.descripcion}</p>rn          <a href="${servicio.enlace}" class="btn-card">Saber mu00e1s</a>rn        </div>rn      </div>rn    `;rn  }rnrn  const track = document.querySelector('.merc-servicios-wrapper .servicios-track');rn  if (!track) return;rnrn  let cardsHTML = '';rn  // Bucle infinitorn  for (let i = 0; i < 10; i++) {rn    servicios.forEach(servicio => {rn      cardsHTML += crearCard(servicio);rn    });rn  }rn  rn  track.innerHTML = cardsHTML;rnrn  // Lu00f3gica de arrastrern  const slider = document.querySelector('.merc-servicios-wrapper .servicios-loop-container');rn  let isDown = false;rn  let startX;rn  let scrollLeft;rnrn  slider.addEventListener('mousedown', (e) => {rn    isDown = true;rn    slider.style.cursor = 'grabbing';rn    track.style.animationPlayState = 'paused';rn    startX = e.pageX - slider.offsetLeft;rn    scrollLeft = slider.scrollLeft;rn  });rnrn  const endDragging = () => {rn    isDown = false;rn    slider.style.cursor = 'grab';rn    if (!slider.matches(':hover')) track.style.animationPlayState = 'running';rn  };rnrn  slider.addEventListener('mouseleave', endDragging);rn  slider.addEventListener('mouseup', endDragging);rnrn  slider.addEventListener('mousemove', (e) => {rn    if (!isDown) return;rn    e.preventDefault();rn    const x = e.pageX - slider.offsetLeft;rn    const walk = (x - startX) * 2;rn    slider.scrollLeft = scrollLeft - walk;rn  });rn})();rn</script>tttt</div>ntttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-b7c2168 e-flex e-con-boxed elementor-invisible e-con e-parent" data-id="b7c2168" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;animation&quot;:&quot;fadeIn&quot;}">nttttt<div class="e-con-inner">ntttt<div class="elementor-element elementor-element-12da26a elementor-position-top elementor-widget elementor-widget-image-box" data-id="12da26a" data-element_type="widget" data-e-type="widget" data-widget_type="image-box.default">nttttt<div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><img width="55" height="49" src="https://mercourier.com/wp-content/uploads/2021/12/home-page-icon-1-white.svg" class="attachment-full size-full wp-image-685" alt="" /></figure><div class="elementor-image-box-content"><h5 class="elementor-image-box-title">Brindamos un seguro para todos tus productos</h5></div></div>tttt</div>ntttt<div class="elementor-element elementor-element-699aaf9 elementor-position-top elementor-widget elementor-widget-image-box" data-id="699aaf9" data-element_type="widget" data-e-type="widget" data-widget_type="image-box.default">nttttt<div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><img width="55" height="56" src="https://mercourier.com/wp-content/uploads/2021/12/home-page-icon-2-white.svg" class="attachment-full size-full wp-image-686" alt="" /></figure><div class="elementor-image-box-content"><h5 class="elementor-image-box-title">Rembolsamos el valor de los productos extraviados</h5></div></div>tttt</div>ntttt<div class="elementor-element elementor-element-295c058 elementor-position-top elementor-widget elementor-widget-image-box" data-id="295c058" data-element_type="widget" data-e-type="widget" data-widget_type="image-box.default">nttttt<div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><img width="49" height="56" src="https://mercourier.com/wp-content/uploads/2021/12/home-page-icon-3-white.svg" class="attachment-full size-full wp-image-684" alt="" /></figure><div class="elementor-image-box-content"><h5 class="elementor-image-box-title">Mayor tranquilidad y confianza a nuestros clientes</h5></div></div>tttt</div>nttttt</div>ntttt</div>ntt<div class="elementor-element elementor-element-b85c483 e-flex e-con-boxed e-con e-parent" data-id="b85c483" data-element_type="container" data-e-type="container">nttttt<div class="e-con-inner">nttttt</div>ntttt</div>ntt","scripts":[],"styles":[]}}
