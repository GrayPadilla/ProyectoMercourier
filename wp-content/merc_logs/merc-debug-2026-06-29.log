        LEFT JOIN wp_postmeta pm_estado_motorizado ON p.ID = pm_estado_motorizado.post_id AND pm_estado_motorizado.meta_key = 'wpcargo_estado_pago_motorizado'
        LEFT JOIN wp_postmeta pm_pickup_date ON p.ID = pm_pickup_date.post_id AND pm_pickup_date.meta_key IN ('wpcargo_pickup_date_picker', 'wpcargo_pickup_date', 'wpcargo_fecha_envio')
        WHERE p.post_type = 'wpcargo_shipment'
        AND p.post_status = 'publish'
        AND pm_driver.meta_value = '190'
        AND STR_TO_DATE(pm_pickup_date.meta_value, '{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}d/{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}m/{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}Y') >= STR_TO_DATE('2026-06-29', '{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}Y-{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}m-{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}d')
        AND STR_TO_DATE(pm_pickup_date.meta_value, '{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}d/{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}m/{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}Y') <= STR_TO_DATE('2026-06-29', '{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}Y-{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}m-{8f064742287ad0b16385985ab8a6f16ac0d7cf51e432ab34a256bdb3d649cb65}d')
    
