[29-Jun-2026 03:11:44 UTC] 🔍 [MERC_ADMIN_CARDS] drivers_sql: SELECT pm_entrega.meta_value AS driver_id, COUNT(DISTINCT p.ID) AS total_entregas FROM wp_posts p LEFT JOIN wp_postmeta pm_entrega ON p.ID = pm_entrega.post_id AND pm_entrega.meta_key = 'wpcargo_motorizo_entrega' WHERE p.post_type = 'wpcargo_shipment' AND p.post_status = 'publish' AND pm_entrega.meta_value IS NOT NULL AND EXISTS( SELECT 1 FROM wp_postmeta pm_pickup WHERE pm_pickup.post_id = p.ID AND pm_pickup.meta_key = 'wpcargo_pickup_date_picker' AND ( STR_TO_DATE(pm_pickup.meta_value, '%d/%m/%Y') >= STR_TO_DATE('2026-06-28', '%Y-%m-%d') AND STR_TO_DATE(pm_pickup.meta_value, '%d/%m/%Y') <= STR_TO_DATE('2026-06-28', '%Y-%m-%d') ) ) GROUP BY pm_entrega.meta_value ORDER BY total_entregas DESC
