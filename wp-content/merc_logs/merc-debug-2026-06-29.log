        SELECT p.ID,
               pm_producto.meta_value         AS costo_producto,
               pm_envio.meta_value            AS costo_envio,
               pm_quien_paga.meta_value       AS quien_paga,
               pm_included.meta_value         AS estado_pago_remitente,
               pm_cliente_pago_a.meta_value   AS cliente_pago_a,
               pm_pickup_date.meta_value      AS pickup_date
        FROM wp_posts p
        LEFT JOIN wp_postmeta pm_shipper 
            ON p.ID = pm_shipper.post_id 
            AND pm_shipper.meta_key = 'registered_shipper'
        LEFT JOIN wp_postmeta pm_producto 
            ON p.ID = pm_producto.post_id 
            AND pm_producto.meta_key = 'wpcargo_costo_producto'
        LEFT JOIN wp_postmeta pm_envio 
            ON p.ID = pm_envio.post_id 
            AND pm_envio.meta_key = 'wpcargo_costo_envio'
        LEFT JOIN wp_postmeta pm_quien_paga 
            ON p.ID = pm_quien_paga.post_id 
            AND pm_quien_paga.meta_key = 'wpcargo_quien_paga'
        LEFT JOIN wp_postmeta pm_included 
            ON p.ID = pm_included.post_id 
            AND pm_included.meta_key = 'wpcargo_included_in_liquidation'
        LEFT JOIN wp_postmeta pm_cliente_pago_a 
            ON p.ID = pm_cliente_pago_a.post_id 
            AND pm_cliente_pago_a.meta_key = 'wpcargo_cliente_pago_a'
        LEFT JOIN wp_postmeta pm_pickup_date
            ON p.ID = pm_pickup_date.post_id
            AND pm_pickup_date.meta_key IN ('wpcargo_pickup_date_picker', 'wpcargo_pickup_date', 'wpcargo_fecha_envio')
        WHERE p.post_type = 'wpcargo_shipment'
        AND p.post_status = 'publish'
        AND pm_shipper.meta_value = '118'
     AND STR_TO_DATE(pm_pickup_date.meta_value, '{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}d/{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}m/{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}Y') >= STR_TO_DATE('2026-06-29', '{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}Y-{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}m-{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}d') AND STR_TO_DATE(pm_pickup_date.meta_value, '{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}d/{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}m/{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}Y') <= STR_TO_DATE('2026-06-29', '{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}Y-{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}m-{ab0f2406ca190770d067ee96221f9eca975beef214262c63572b3bb0575faa8d}d')
