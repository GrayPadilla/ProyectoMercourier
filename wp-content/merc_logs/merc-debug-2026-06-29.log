        SELECT 
            p.ID, 
            p.post_date,
            pm_status.meta_value as estado,
            pm_pago.meta_value as estado_pago,
            pm_fecha_reprog.meta_value as fecha_reprogramada
        FROM wp_posts p
        LEFT JOIN wp_postmeta pm_shipper 
            ON p.ID = pm_shipper.post_id 
