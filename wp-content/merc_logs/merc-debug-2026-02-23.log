n    }\r\n\r\n    .card-glass ul { list-style: none; padding: 0; margin: 0; }\r\n\r\n    .card-glass ul li {\r\n        color: rgba(255, 255, 255, 0.9);\r\n        font-size: 14px;\r\n        font-weight: 500;\r\n        padding: 12px 0;\r\n        border-bottom: 1px solid rgba(255, 255, 255, 0.05);\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n    }\r\n\r\n    \/* PRECIO CON EFECTO LIQUID GLASS REAL *\/\r\n    .precio-liquid-glass {\r\n        background: rgba(255, 255, 255, 0.15); \/* Efecto vidrio *\/\r\n        backdrop-filter: blur(10px);\r\n        -webkit-backdrop-filter: blur(10px);\r\n        border: 1px solid rgba(255, 255, 255, 0.3); \/* Brillo en el borde *\/\r\n        color: #ffffff;\r\n        font-weight: 800;\r\n        font-size: 13px;\r\n        padding: 5px 12px;\r\n        border-radius: 12px;\r\n        min-width: 70px;\r\n        text-align: center;\r\n        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\r\n        transition: all 0.3s ease;\r\n    }\r\n\r\n    .card-glass ul li:hover .precio-liquid-glass {\r\n        background: rgba(255, 255, 255, 0.25);\r\n        border-color: #ff0000;\r\n        transform: scale(1.05);\r\n    }\r\n\r\n    @media (max-width: 600px) {\r\n        .grid-glass { grid-template-columns: 1fr; }\r\n    }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","scripts":[],"styles":[]}}
