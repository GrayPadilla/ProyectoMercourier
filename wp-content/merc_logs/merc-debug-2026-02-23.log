[23-Feb-2026 04:11:05 UTC] 🔍 [MERC_ADMIN_CLIENTS] clients_sql: SELECT pm_sender.meta_value AS client_id, COUNT(DISTINCT p.ID) AS total_envios FROM wp_posts p LEFT JOIN wp_postmeta pm_sender ON p.ID = pm_sender.post_id AND pm_sender.meta_key = 'registered_shipper' WHERE p.post_type = 'wpcargo_shipment' AND p.post_status = 'publish' AND pm_sender.meta_value IS NOT NULL AND pm_sender.meta_value != '' AND ( EXISTS( SELECT 1 FROM wp_postmeta pm_pickup WHERE pm_pickup.post_id = p.ID AND pm_pickup.meta_key IN ('wpcargo_pickup_date_picker','wpcargo_pickup_date','calendarenvio','wpcargo_fecha_envio') AND ( (STR_TO_DATE(pm_pickup.meta_value, '%%d/%%m/%%Y') >= STR_TO_DATE('2026-02-22', '%%Y-%%m-%%d') AND STR_TO_DATE(pm_pickup.meta_value, '%%d/%%m/%%Y') <= STR_TO_DATE('2026-02-22', '%%Y-%%m-%%d')) OR (STR_TO_DATE(pm_pickup.meta_value, '%%Y-%%m-%%d') >= STR_TO_DATE('2026-02-22', '%%Y-%%m-%%d') AND STR_TO_DATE(pm_pickup.meta_value, '%%Y-%%m-%%d') <= STR_TO_DATE('2026-02-22', '%%Y-%%m-%%d')) OR (pm_pickup.meta_value BETWEEN '2026-02-22' AND '2026-02-22') OR (pm_pickup.meta_value LIKE '2026-02-22%') ) ) OR (p.post_date BETWEEN '2026-02-22 00:00:00' AND '2026-02-22 23:59:59') ) GROUP BY pm_sender.meta_value ORDER BY total_envios DESC
